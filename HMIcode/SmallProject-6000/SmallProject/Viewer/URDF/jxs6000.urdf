<?xml version="1.0" encoding="utf-8"?>
<robot name="jxs6000">
  <!--
    Kinematic preview model derived from the supplied JXS6000 S1-S6 STL
    assembly dated 2026-11. STL coordinates are millimetres with CAD +Y up;
    mesh origins rotate CAD into the URDF Z-up frame and scale to metres.

    S1 is stationary. S2-S6 belong to link_1-link_5. Physical joint_6 controls
    the output flange from -180 to +180 degrees. Its axis is retained from the
    existing tool frame; separate flange/gripper meshes were not supplied.
    Joint limits and dynamics are provisional until production limits and
    calibrated mass properties are available.
  -->

  <material name="base_gray"><color rgba="0.34 0.38 0.42 1" /></material>
  <material name="motor_gray"><color rgba="0.58 0.62 0.66 1" /></material>
  <material name="arm_yellow"><color rgba="0.88 0.80 0.08 1" /></material>
  <material name="wrist_green"><color rgba="0.08 0.62 0.18 1" /></material>

  <link name="base_link">
    <visual name="s1_visual">
      <origin xyz="0 0 0.160000000" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/meshes/s1.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="base_gray" />
    </visual>
    <collision name="s1_collision">
      <origin xyz="0 0 0.160000000" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/collision/s1.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
  </link>

  <link name="link_1">
    <visual name="s2_visual">
      <origin xyz="0 0 0" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/meshes/s2.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="motor_gray" />
    </visual>
    <collision name="s2_collision">
      <origin xyz="0 0 0" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/collision/s2.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
  </link>

  <link name="link_2">
    <visual name="s3_visual">
      <origin xyz="0 0 -0.050000000" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/meshes/s3.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="arm_yellow" />
    </visual>
    <collision name="s3_collision">
      <origin xyz="0 0 -0.050000000" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/collision/s3.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
  </link>

  <link name="link_3">
    <visual name="s4_visual">
      <origin xyz="0 0.360000000 -0.050000000" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/meshes/s4.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="arm_yellow" />
    </visual>
    <collision name="s4_collision">
      <origin xyz="0 0.360000000 -0.050000000" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/collision/s4.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
  </link>

  <link name="link_4">
    <visual name="s5_visual">
      <origin xyz="0 0.028288500 -0.170733100" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/meshes/s5.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="wrist_green" />
    </visual>
    <collision name="s5_collision">
      <origin xyz="0 0.028288500 -0.170733100" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/collision/s5.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
  </link>

  <link name="link_5">
    <visual name="s6_visual">
      <origin xyz="0.103500000 -0.020106000 -0.188347000" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/meshes/s6.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="wrist_green" />
    </visual>
    <collision name="s6_collision">
      <origin xyz="0.103500000 -0.020106000 -0.188347000" rpy="1.570796327 0 0" />
      <geometry><mesh filename="package://jxs6000_description/collision/s6.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
  </link>

  <link name="link_6" />

  <joint name="joint_1" type="revolute">
    <parent link="base_link" /><child link="link_1" />
    <origin xyz="0 0 0.160000000" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.141592654" upper="3.141592654" effort="120" velocity="1.5" />
    <dynamics damping="0.15" friction="0.05" />
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1" /><child link="link_2" />
    <origin xyz="0 0 0.050000000" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-4.363323130" upper="3.141592654" effort="120" velocity="1.5" />
    <dynamics damping="0.15" friction="0.05" />
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2" /><child link="link_3" />
    <origin xyz="0 -0.360000000 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.141592654" upper="5.759586532" effort="100" velocity="1.5" />
    <dynamics damping="0.15" friction="0.05" />
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="link_3" /><child link="link_4" />
    <origin xyz="0 0.331711500 0.120733100" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.141592654" upper="3.141592654" effort="70" velocity="2.0" />
    <dynamics damping="0.12" friction="0.04" />
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="link_4" /><child link="link_5" />
    <origin xyz="-0.103500000 0.048394500 0.017613900" rpy="0 0 0" />
    <axis xyz="0 -0.939692621 -0.342020143" />
    <limit lower="-1.570796327" upper="6.283185307" effort="45" velocity="2.0" />
    <dynamics damping="0.10" friction="0.03" />
  </joint>

  <joint name="joint_6" type="revolute">
    <parent link="link_5" /><child link="link_6" />
    <origin xyz="0.161000000 0.066624000 0.024253000" rpy="0 0 0" />
    <axis xyz="0.939692621 0 0.342020143" />
    <limit lower="-3.141592654" upper="3.141592654" effort="30" velocity="2.5" />
    <dynamics damping="0.08" friction="0.02" />
  </joint>

  <link name="tool0" />
  <joint name="tool0_fixed" type="fixed">
    <parent link="link_6" /><child link="tool0" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
</robot>
